# Configuración de exchange-service (Node.js + Express + SQLite)
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:4200

# Ruta del archivo SQLite (en Fly.io usar el volumen persistente /data/exchange-2026.sqlite)
DB_PATH=./data/exchange-2026.sqlite

# Orígenes permitidos para CORS separados por coma (* permite todos, o ej. https://tuusuario.github.io,http://localhost:4200)
CORS_ORIGINS=*

# Clave secreta para cifrado AES-256-GCM en SQLite (si se omite, se genera en data/.encryption.key)
DATA_ENCRYPTION_KEY=cambia-esta-clave-secreta-por-una-frase-larga-y-aleatoria

# Feature flag global para envío de correos (por defecto false). También editable desde el Panel Admin.
EMAIL_ENABLED=false
REQUIRE_EMAIL_CONFIRMATION=true
NOTIFY_INCLUDE_FRIEND_NAME=false

# SMTP (opcional; si SMTP_HOST está vacío y EMAIL_ENABLED=true, guarda previsualizaciones HTML en data/outbox/)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Intercambio Navideño 2026 <no-reply@intercambio2026.local>"

# Super Admin inicial (obligatorio definir ambos para que se cree automáticamente al iniciar con BD limpia)
# En producción (Fly.io) configúralos como Secrets, NUNCA los subas al repositorio.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
